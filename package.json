{
  "name": "keeplog-repo-tools",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "check:front:lint": "cd front && yarn lint",
    "check:front:type": "cd front && yarn tsc --noEmit",
    "check:server:lint": "cd server && .venv/bin/ruff check . && .venv/bin/ruff format --check .",
    "check:server:test": "cd server && .venv/bin/pytest -q",
    "check:commit": "pnpm check:front:lint && pnpm check:server:lint",
    "check:push": "pnpm check:front:type && pnpm check:server:test",
    "commit:all": "node scripts/commit-all.mjs",
    "issue:create": "node scripts/github-issue.mjs",
    "pr:create": "node scripts/github-pr.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
